# Copie para .env e preencha antes de rodar `docker compose up`.
# Nunca commitar o .env real.

# --- Django ---
DJANGO_SECRET_KEY=troque-por-uma-chave-aleatoria-longa
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,api
CSRF_TRUSTED_ORIGINS=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
# "Lax" serve quando front e API estão no mesmo domínio (atrás do Caddy).
# Em deploy split-domain (Vercel + Render, por ex.), use "None" — exige
# SESSION_COOKIE_SECURE/CSRF_COOKIE_SECURE=true (HTTPS nos dois lados).
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax
LOG_LEVEL=INFO

# --- Banco de dados ---
POSTGRES_DB=finez
POSTGRES_USER=finez
POSTGRES_PASSWORD=finez
DATABASE_URL=postgres://finez:finez@postgres:5432/finez

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0

# --- Criptografia (Fernet) ---
# Gere com: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# --- Pluggy (sandbox) — https://dashboard.pluggy.ai ---
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
PLUGGY_BASE_URL=https://api.pluggy.ai
PLUGGY_WEBHOOK_SECRET=

# --- brapi.dev (cotações de ações/FIIs) — https://brapi.dev/dashboard ---
BRAPI_TOKEN=

# --- WhatsApp (adaptador Baileys) ---
WHATSAPP_ADAPTER_URL=http://whatsapp:3333
WHATSAPP_ADAPTER_TOKEN=troque-por-um-token-interno-aleatorio
WHATSAPP_WEBHOOK_SECRET=troque-por-outro-token-aleatorio
# Chave de criptografia da sessão do Baileys (AES-256-GCM). Gere com: openssl rand -hex 32
WHATSAPP_SESSION_KEY=

# --- LLM (fallback do parser — só acionado quando a heurística de regex falha) ---
# Único provedor suportado hoje: "anthropic". Sem essas duas vars, mensagens não
# reconhecidas pela heurística caem direto em "não entendi" (comportamento anterior).
LLM_PROVIDER=
LLM_API_KEY=
# Opcional — default já é um modelo bom/barato pra essa tarefa de extração.
LLM_MODEL=claude-haiku-4-5-20251001

# --- Sentry (opcional) ---
SENTRY_DSN=

# --- Frontend (Vite) ---
VITE_API_URL=http://localhost:8000
